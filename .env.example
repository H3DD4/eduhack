# Copy to api/.env (git-ignored). Never commit real keys.
# Without any key, ThinkFirst uses clearly labeled demo adapters ("Simulated assessment", "Demo transcription").

# --- AI providers (optional) ---
LLM_PROVIDER=auto            # auto | demo | anthropic | gemini | groq | ollama
LLM_FALLBACK=true            # on error/invalid output try the next configured real provider
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:20b
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Speech-to-text. demo (default) never sends audio anywhere. groq/gemini send RAW AUDIO to that processor
# (disclosed in the UI before capture). Decide processors before production (docs/OPEN_QUESTIONS.md Q-05).
STT_PROVIDER=demo
GROQ_STT_MODEL=whisper-large-v3

# --- RAG: Hugging Face cloud embedder + Qdrant (docker service). Without HF_TOKEN a labelled demo embedder is used.
# Chunk text is sent to Hugging Face only to compute vectors (docs/OPEN_QUESTIONS.md Q-15).
HF_TOKEN=
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_EMBED_DIM=384
VECTOR_BACKEND=auto           # auto | qdrant | postgres
QDRANT_URL=                   # docker compose sets http://qdrant:6333; local dev: http://localhost:6333

# --- Google sign-in (optional; button hidden when empty) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local, no-Docker defaults (docker-compose overrides these) ---
DATABASE_URL=sqlite:///./thinkfirst-dev.db
JOB_MODE=inline
STORAGE_BACKEND=local
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
